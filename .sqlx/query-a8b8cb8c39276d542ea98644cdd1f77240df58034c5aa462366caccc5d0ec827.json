  "db_name": "SQLite",
  "query": "\n        SELECT\n            m.id as \"id!\",\n            m.provider_id as \"provider_id!\",\n            m.title as \"title!\",\n            m.kind as \"kind!\",\n            m.year,\n            m.description,\n            m.poster_url,\n            m.rating,\n            m.genres,\n            m.total_episodes,\n            m.total_seasons,\n            m.anilist_id,\n            m.tmdb_id,\n            m.mal_id,\n            m.external_id\n        FROM favorites f\n        JOIN media m ON m.id = f.media_id\n        ORDER BY f.added_at DESC\n        ",
